Universe       = vanilla
Notification   = Never
Initialdir     = /gpfs/mnt/gpfs02/phenix/plhf/plhf1/mitran/Simul/Dileptons/sim/gen/pythia6/
+Experiment     = "PHENIX"
+Job_Type       = "cas"
